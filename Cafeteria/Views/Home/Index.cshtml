@{
    ViewData["Title"] = "Catalogo";
}
@* BANNER *@

@*seção banner | banner | carrossel *@
<section class="container text-center mt-5 mb-5">

    @* TEXTO *@ @* display-5 tamanho do text*@
    <h1 class="display-5 fw-bold">Presentes que dizem <span class="fonte-fraunces fst-italic text-gold">o que você sente</span></h1>
    <p class="fs-5 text-secondary">Cestas montadas à mão, com cartão personalizado.</p>

    @* BOTÕES *@
    <div class="d-flex justify-content-center align-items-center gap-4 mt-4">
        @* separação de 4 (gap) margin top (4) d-flex, alinha tudo ao centro*@
        <a href="#catalogo" class="btn btn-dark rounded-pill px-4">Ver cestas</a>
        <a asp-controller="Home" asp-action="TotalProduto" class="link-dark text-decoration-none">Ver catálogo → </a>
        @* &rsqaquo serve para representar > *@
    </div>

    @* CARROSSEL (passa sozinho; setas e bolinhas embaixo da foto) *@
    <div id="bannerCarousel" class="carousel slide mt-4" data-bs-ride="carousel" data-bs-interval="4000"
        data-bs-pause="false">
        @* data-bs-ride serve para controla o compartamento de carrosel*@

        @* FOTOS do carrosel *@
        <div class="carousel-inner rounded-4">
            @* imagem 1 *@
            <div class="carousel-item active">
                <div class="ratio ratio-21x9">
                    <img src="~/imgs/banners/banner_cartao.jpg"
                        class="d-block w-100 object-fit-cover" alt="Gift Box Cestas Criativas, Itápolis SP">
                </div>
            </div>
            @* imagem 2 *@
            <div class="carousel-item">
                <div class="ratio ratio-21x9">
                    <img src="~/imgs/banners/banner_natal_novo.jpg"
                        class="d-block w-100 object-fit-cover" alt="Natal Gift Box: cestas de Natal">
                </div>
            </div>

            @* imagem 3 *@
            <div class="carousel-item">
                <div class="ratio ratio-21x9">
                    <img src="~/imgs/banners/banner_loja.jpg"
                        class="d-block w-100 object-fit-cover" alt="Feita com carinho, do seu jeito. Escolha a sua, personalize e solicite o pedido">
                </div>
            </div>

        </div>

        @* SETAS + BOLINHAS (embaixo da foto, lado a lado) *@

        @* seta esquerda*@
        <div class="d-flex justify-content-center align-items-center gap-3 mt-3">
            <button class="btn btn-light btn-sm rounded-circle" type="button" data-bs-target="#bannerCarousel"
                data-bs-slide="prev" aria-label="Anterior">
                <span class="bi bi-chevron-left"></span> @* setinha embaixo *@
            </button>

            @* bolinhas*@
            <div class="carousel-indicators position-static m-0">
                <button type="button" data-bs-target="#bannerCarousel" data-bs-slide-to="0" class="active bg-dark"
                    aria-label="Foto 1"></button>
                <button type="button" data-bs-target="#bannerCarousel" data-bs-slide-to="1" class="bg-dark"
                    aria-label="Foto 2"></button>
                <button type="button" data-bs-target="#bannerCarousel" data-bs-slide-to="2" class="bg-dark"
                    aria-label="Foto 3"></button>
            </div>
            @* seta direita *@
            <button class="btn btn-light btn-sm rounded-circle" type="button" data-bs-target="#bannerCarousel"
                data-bs-slide="next" aria-label="Próxima">
                <span class="bi bi-chevron-right"></span>
            </button>
        </div>

    </div>
</section>

