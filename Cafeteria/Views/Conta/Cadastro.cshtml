@model Services.Models.CadastroSite
@{
    Layout = null; 
}
<!DOCTYPE html>             @* layout null, ele nao precisa de layout ja que é uma tela de login *@
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Criar conta</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/css/client.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>

<body>


    @* container principal do login separando a tela em 2 column de 6 por 6 (login/imagem)*@

    <div class="container-fluid p-0"> @* container 100% da tela padding interno zerado por padrao *@
        <div class="row g-0">
            @* linha obrigatoria da hierarquia do bootstrap g-0 = gutter espaçamentos zerados por padrao*@
            <div class="col-12 col-md-6 min-vh-100 d-flex align-items-center justify-content-center pt-4 pt-md-0">

                <div class="col-8 my-auto py-4">
                    @* cada col funciona em sua proprio elemento pai, tipo col 6 > col 8 >*@

                    @*logo da gift box: o link leva para a página inicial do site *@
                    @* d-inline-flex: só a logo é clicável, não a linha inteira. link-dark e text-decoration-none: sem azul e sem sublinhado *@
                    <a asp-controller="Home" asp-action="Index" class="d-inline-flex align-items-center mb-4 mb-md-5 link-dark text-decoration-none">
                        <img src="~/imgs/gift_box_logo.png" alt="Logo Gift Box" width="64" class="rounded-circle me-3">
                        <div>
                            <p class="fs-4 fw-bold mb-0">GIFT BOX</p>
                            <p class="text-gold mb-0">cestas criativas</p>
                        </div>
                    </a>
                    <h1 class="fs-3 fw-bold">Criar conta</h1> @* font-size e font-weight*@
                    <p class="text-secondary mb-3 mb-md-4">Leva menos de um minuto.</p>
                    @* secondary é a cor do texto*@

                    @* formulario da gift box *@
                    <form asp-controller="Conta" asp-action="Cadastro" method="post"> 

                        @* asp-controller =Conta asp-action= "Cadastro" Metodo "post" 
                        para enviar dados para o sistema
                    e sem mostrar no navegador a senha ou o email (evita ataques de broken access control) *@

                        <div class="mb-4 mb-md-3">
                            <label for="nome" class="form-label fw-semibold">Nome</label>
                            <input type="text" class="form-control" id="nome" name="Nome"
                                placeholder="Como quer ser chamado">

                            <span asp-validation-for="Nome" class="text-danger"></span> @* nome obrigatorio *@
                        </div>

                      

                        <div class="mb-4  mb-md-3"> @* margin bottom de 3 *@
                            <label for="email" class="form-label fw-semibold">E-mail</label>
                            @* form-label estilo bootstrap para o rotulo*@
                            <input type="email" class="form-control" id="email" name="Email"
                                placeholder="seu@email.com"> @* input *@

                            <span asp-validation-for="Email" class="text-danger"></span> @* validação dos textos corretos *@
                        </div>
                    

                        @* estilo bootstrap para campo de digitar*@
                        <div class="mb-4  mb-md-3">
                            <label for="senha" class="form-label fw-semibold">Senha</label>

                            @* icone da senha *@
                            <div class="input-group">
                                <input type="password" class="form-control" id="senha" name="Senha"
                                    placeholder="digite sua senha"> @*input*@
                                <button class="btn border" type="button" aria-label="Mostrar senha" data-mostrar-senha>
                                    <span class="bi bi-eye"></span>
                                </button>

                                <span asp-validation-for="Senha" class="text-danger"></span> @* validação senha *@
                            </div>
                   
                        </div>

                        @*botao de criar conta*@
                        <button type="submit" class="btn btn-dark w-100 rounded-pill">Criar conta</button>
                        @* btn - transformar em botao bootstrap, fundo dark *@
                        <div class="d-flex align-items-center my-3 my-md-2">
                            @* display flex alinhado ao centro, margin eixo y de 3*@
                            <hr class="flex-grow-1">
                            @* cada linha estica para ocupar o espaço que sobra dentro da div*@
                            <span class="px-2 text-secondary">ou</span> @* padding eixo x 2*@
                            <hr class="flex-grow-1">
                        </div>
                        @* botao do google*@
                        <button type="button" class="btn btn-outline-secondary rounded-pill w-100">Cadastrar com
                            Google</button>
                        @*rounded-pill totalmente arredondado, w-100%, outline sem fundo apenas borda *@
                    </form>

                    @* ja tem login*@
                    <p class="text-center text-secondary mt-3">Já tem conta? <a asp-controller="Conta" asp-action="Login"
                            class="link-dark fw-semibold">Entrar</a></p>

                </div>
            </div>

            @*imagem e gifts*@

            @* coluna 6 de 12 do grid system e min-vh significa 100% da altura da tela *@
            <div class="col-md-6 position-relative d-none d-md-block p-2">

                @* painel-login + painel-animado (client.css): fundo dourado se mexendo; d-flex centraliza o cartão *@
                <div class="painel-login painel-animado w-100 h-100 rounded-4 d-flex align-items-center justify-content-center p-4">

                    @* cartao (client.css): levemente inclinado e flutuando *@
                    <div class="cartao bg-white rounded-4 shadow p-5">
                        <p class="text-secondary mb-4">Para: <span class="text-dark">Você</span></p>
                        @* digitando (client.css): a frase vai aparecendo da esquerda para a direita *@
                        <p class="fs-2 fst-italic mb-4"><span class="digitando">Seu presente começa aqui.</span></p>
                        <p class="text-secondary text-end mb-0">De: <span class="text-dark">Gift Box</span></p>
                    </div>

                </div>
            </div>

        </div>
    </div>



    @* carrega o site.js (mostrar/esconder senha) *@
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>

</html>