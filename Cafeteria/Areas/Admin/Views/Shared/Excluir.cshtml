@{
    ViewData["Title"] = "Confirmar exclusão";
}

@* confirmação comum do Yago (usada em Usuários), no formato do seu modal *@
<div class="container py-5"></div>

@* janela de confirmação já aberta, sem JavaScript: d-block mostra a janela e bg-dark bg-opacity-50 escurece o fundo *@
<div class="modal d-block bg-dark bg-opacity-50" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="titulo-modal">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 p-3 text-center">
            <div class="modal-body">
                <h2 class="fs-4 fw-bold" id="titulo-modal">Excluir @ViewData["Descricao"]?</h2>
                <p class="text-secondary">Essa ação não pode ser desfeita.</p>
                <div asp-validation-summary="All" class="text-danger small"></div>
                <form asp-action="Excluir" asp-route-id="@ViewData["Id"]" method="post" class="row g-2">
                    <div class="col-6"><a asp-action="Index" class="btn btn-light border w-100">Cancelar</a></div>
                    <div class="col-6"><button type="submit" class="btn btn-danger w-100">Excluir</button></div>
                </form>
            </div>
        </div>
    </div>
</div>
