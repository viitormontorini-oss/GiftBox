@model Business.Cliente
@{
    ViewData["Title"] = "Excluir cliente";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
    var numero = "#" + Model.id.ToString("D5");
    var iniciais = string.Concat(Model.nome.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpper(p[0])));
    var enderecos = Model.Enderecos.Where(e => e.pedido == null).ToList();
    var endereco = enderecos.FirstOrDefault();
}

<div class="container py-5">

        @* caminho: lista / item atual *@
        <p class="small text-secondary mb-2">
            <a asp-area="Admin" asp-controller="AdminClientes" asp-action="Index" class="link-secondary text-decoration-none">Clientes</a> / Cliente
            @numero
        </p>
        @* título à esquerda, botões à direita *@
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">

            @* primeiro elemento da div do d-flex*@
            <div class="d-flex align-items-center gap-3">
                <h1 class="fs-2 fw-bold mb-0">Cliente @numero</h1>
                <span class="d-inline-flex align-items-center gap-2">
                    <span class="rounded-circle bg-success d-inline-block p-1"></span>
                    Ativo
                </span>
            </div>
            @* 2 elemento da div do d-flex*@
            <div class="d-flex flex-wrap gap-2">
                <a asp-area="Admin" asp-controller="AdminClientes" asp-action="Editar" asp-route-id="@Model.id" class="btn btn-light border">Editar</a>
                <a asp-area="Admin" asp-controller="AdminClientes" asp-action="Excluir" asp-route-id="@Model.id" class="btn btn-outline-danger">Excluir</a>
            </div>
        </div>


        @* row *@
        <div class="row g-4">

            @* row do lado esquerdo*@
            <div class="col-12 col-lg-5">

                @* section *@
                <section class="bg-white border rounded-4 p-4 h-100">
                    <h2 class="fs-5 fw-bold mb-4">Dados pessoais</h2>


                    @* elemento do nome e do icon*@
                    <div class="d-flex align-items-center mb-4">

                        @* circulo *@
                        <span
                            class="avatar-lg flex-shrink-0 d-inline-flex align-items-center justify-content-center rounded-circle bg-secondary-subtle text-secondary-emphasis fs-5 fw-semibold me-3">@iniciais</span>

                        <div>
                            <p class="fw-bold fs-5 mb-0">@Model.nome</p>
                            <p class="text-secondary mb-0">@Model.pedidos.Count pedido(s)</p>
                        </div>
                    </div>

                    @* texto abaixo *@
                    <p class="text-secondary small text-uppercase fw-semibold mb-1">E-mail</p>
                    <p class="text-break mb-3">@Model.email</p>
                    <p class="text-secondary small text-uppercase fw-semibold mb-1">Telefones</p>
                    <p class="text-break mb-3">@Model.telefones.FirstOrDefault()?.numero@foreach (var tel in Model.telefones.Skip(1)) {<br><span class="text-secondary">@tel.numero</span>}</p>
                </section>
            </div>

            @* row do lado direito *@
            <div class="col-12 col-lg-7">
                <section class="bg-white border rounded-4 p-4 h-100">
                    <h2 class="fs-5 fw-bold mb-4">Endereços</h2>
                    @if (endereco == null)
                    {
                        <p class="text-secondary mb-0">Nenhum endereço cadastrado.</p>
                    }
                    else
                    {
                        @* abas de endereço: a escolhida é a escura *@
                        <div class="d-flex flex-wrap gap-2 mb-4">
                            @for (var i = 0; i < enderecos.Count; i++)
                            {
                                <a href="#" class="btn @(i == 0 ? "btn-dark" : "btn-outline-secondary") btn-sm rounded-pill">Endereço @(i + 1)</a>
                            }
                        </div>

                        @* row dos elementos dentro da row de separação *@
                        <div class="row">
                            <div class="col-12 col-sm-6">
                                <p class="text-secondary small text-uppercase fw-semibold mb-1">CEP</p>
                                <p class="text-break mb-3">@endereco.cep</p>
                            </div>
                            <div class="col-12 col-sm-6">
                                <p class="text-secondary small text-uppercase fw-semibold mb-1">Rua</p>
                                <p class="text-break mb-3">@endereco.logradouro, @endereco.numero</p>
                            </div>

                            <div class="col-12 col-sm-6">
                                <p class="text-secondary small text-uppercase fw-semibold mb-1">Bairro</p>
                                <p class="text-break mb-3">@endereco.bairro</p>
                            </div>
                            <div class="col-12 col-sm-6">
                                <p class="text-secondary small text-uppercase fw-semibold mb-1">Complemento</p>
                                <p class="text-break mb-3">@(endereco.complemento ?? "—")</p>
                            </div>

                            <div class="col-12 col-sm-6">
                                <p class="text-secondary small text-uppercase fw-semibold mb-1">Cidade</p>
                                <p class="text-break mb-3">@endereco.cidade</p>
                            </div>
                        </div>
                    }


                </section>
            </div>
        </div>


    </div>


    @* janela do model *@

    @* janela de confirmação já aberta, sem JavaScript: d-block mostra a janela e bg-dark bg-opacity-50 escurece o fundo *@
    <div class="modal d-block bg-dark bg-opacity-50" tabindex="-1" role="dialog" aria-modal="true"
        aria-labelledby="titulo-modal">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 rounded-4 p-3 text-center">
                <div class="modal-body">
                    <h2 class="fs-4 fw-bold" id="titulo-modal">Excluir cliente @numero?</h2>
                    <p class="text-secondary">Os pedidos antigos continuam salvos. Essa ação não pode ser desfeita.</p>
                    @* cliente com pedido não pode ser excluído: o motivo aparece aqui *@
                    <div asp-validation-summary="All" class="text-danger small"></div>
                    <form asp-area="Admin" asp-controller="AdminClientes" asp-action="Excluir" asp-route-id="@Model.id" method="post" class="row g-2">
                        <div class="col-6"><a asp-area="Admin" asp-controller="AdminClientes" asp-action="Ver" asp-route-id="@Model.id"
                                class="btn btn-light border w-100">Cancelar</a></div>
                        <div class="col-6"><button type="submit"
                                class="btn btn-danger w-100">Excluir</button></div>
                    </form>
                </div>
            </div>
        </div>
    </div>
