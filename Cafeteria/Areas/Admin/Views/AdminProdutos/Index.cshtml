@using Business
@using System.Globalization
@model List<Business.Produto>
@{
    ViewData["Title"] = "Produtos";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
    var br = CultureInfo.GetCultureInfo("pt-BR");
}

<div class="container py-5">

        @* título à esquerda; busca à direita *@
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
            <h1 class="fs-2 fw-bold mb-0">Produtos</h1>

            @* busca do Yago: formulário GET, o Enter envia. O filtro Ativos/Inativos saiu (só funcionava com Enter) *@
            <form method="get" asp-area="Admin" asp-controller="AdminProdutos" asp-action="Index" class="d-flex flex-wrap gap-2">
                @* apenas acessibilidade, nao tem pq tirar agora *@
                <label for="pesquisa" class="visually-hidden">Pesquisar</label>
                <input type="search" class="form-control w-auto" id="pesquisa" name="busca" size="28"
                    placeholder="Buscar produto" value="@ViewBag.Busca">
            </form>
        </div>

        @* faixa verde depois de salvar (TempData, igual ao Yago) *@
        @if (TempData["Sucesso"] is string mensagem)
        {
            <div class="alert alert-success" role="status">@mensagem</div>
        }

        @* table-responsive: rola para o lado no celular. align-middle: texto no meio da linha  ( TERMINAR DE VER AMANHA )*@
        <div class="bg-white border rounded-4 overflow-hidden">
            <div class="table-responsive"> @* tabela responsiva *@
                <table class="table align-middle mb-0">

                    @* tabela cabeça da tabela*@
                    <thead>
                        <tr>
                            @* th scope serve para ligar o conteudo a coluna de baixo*@
                            <th scope="col" class="text-secondary small text-uppercase fw-semibold">Produto</th>
                            <th scope="col" class="text-secondary small text-uppercase fw-semibold">Estoque</th>
                            <th scope="col" class="text-secondary small text-uppercase fw-semibold">Preço</th>
                            <th scope="col" class="text-secondary small text-uppercase fw-semibold">Status</th>
                            <th scope="col" class="text-secondary small text-uppercase fw-semibold"></th>
                        </tr>
                    </thead>

                    @* corpo da tabela*@
                    <tbody>

                        @* uma linha por produto do banco; o status sai do estoque:
                           0 = Inativo (linha cinza) · até 5 = Estoque baixo (vermelho) · mais de 5 = Ativo (verde) *@
                        @foreach (var produto in Model)
                        {
                            var foto = Url.Content(produto.imagem ?? "~/imgs/produtos/produto.jpg");
                            if (produto.quantidade == 0)
                            {
                                <tr class="text-secondary"> @* pois esta inativo *@
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <img src="@foto" alt="" width="44" height="44"
                                                class="rounded-3 opacity-50 object-fit-cover me-3">
                                            @produto.nome
                                        </div>
                                    </td>
                                    <td>@produto.quantidade</td>
                                    <td>@produto.preco.ToString("C2", br)</td>
                                    <td>
                                        <span class="d-inline-flex align-items-center gap-2 text-secondary">
                                            <span class="rounded-circle bg-secondary d-inline-block p-1"></span>
                                            Inativo
                                        </span>
                                    </td>
                                    <td class="text-end text-nowrap">
                                        <a asp-area="Admin" asp-controller="AdminProdutos" asp-action="Editar" asp-route-id="@produto.id"
                                            class="btn btn-outline-success btn-sm">Reativar</a> @* botao ficar menor *@
                                    </td>
                                </tr>
                                continue;
                            }
                            var baixo = produto.quantidade <= 5;
                            <tr>
                                @* imagem e nome*@
                                <td>
                                    <div class="d-flex align-items-center">
                                        <img src="@foto" alt="@produto.nome" width="44" height="44"
                                            class="rounded-3 object-fit-cover me-3">
                                        @produto.nome
                                    </div>
                                </td>

                                @* unidade e preço*@
                                <td class="@(baixo ? "fw-bold text-danger" : "")">@produto.quantidade</td>
                                <td class="fw-bold">@produto.preco.ToString("C2", br)</td>

                                @*estoque e bolinha informando *@
                                <td>
                                    <span class="d-inline-flex align-items-center gap-2">
                                        <span class="rounded-circle @(baixo ? "bg-danger" : "bg-success") d-inline-block p-1"></span>
                                        @(baixo ? "Estoque baixo" : "Ativo")
                                    </span>
                                </td>

                                @* os butoes de ver, editar e inativar *@
                                <td class="text-end text-nowrap">
                                    <a asp-area="Admin" asp-controller="AdminProdutos" asp-action="Ver" asp-route-id="@produto.id" class="btn btn-light border btn-sm">Ver</a>
                                    <a asp-area="Admin" asp-controller="AdminProdutos" asp-action="Editar" asp-route-id="@produto.id" class="btn btn-light border btn-sm">Editar</a>
                                    @* Inativar muda o banco (estoque vai para 0), por isso é um formulário POST. d-inline: fica na mesma linha dos outros botões *@
                                    <form method="post" asp-area="Admin" asp-controller="AdminProdutos" asp-action="Inativar" asp-route-id="@produto.id" class="d-inline">
                                        <button type="submit" class="btn btn-light border btn-sm text-secondary">Inativar</button>
                                    </form>
                                </td>
                            </tr>
                        }

                        @if (!Model.Any())
                        {
                            <tr><td colspan="5" class="text-center text-secondary py-4">Nenhum produto cadastrado.</td></tr>
                        }

                    </tbody>
                </table>
            </div>
        </div>

    </div>
