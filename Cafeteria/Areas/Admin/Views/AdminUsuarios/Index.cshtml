@model List<Business.Usuario>
@{
    ViewData["Title"] = "Usuários";
}

@* lista de usuários do Yago, no seu estilo (igual à de Clientes) *@
<div class="container py-5">

        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
            <h1 class="fs-2 fw-bold mb-0">Usuários</h1>
        </div>

        @* faixa verde depois de salvar (TempData) *@
        @if (TempData["Sucesso"] is string mensagem)
        {
            <div class="alert alert-success" role="status">@mensagem</div>
        }

        <div class="bg-white border rounded-4 overflow-hidden">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th scope="col" class="text-secondary small text-uppercase fw-semibold">Nome</th>
                            <th scope="col" class="text-secondary small text-uppercase fw-semibold">E-mail</th>
                            <th scope="col" class="text-secondary small text-uppercase fw-semibold">Login</th>
                            <th scope="col" class="text-secondary small text-uppercase fw-semibold">Nível</th>
                            <th scope="col" class="text-secondary small text-uppercase fw-semibold"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var usuario in Model)
                        {
                            <tr>
                                <td>@usuario.nome</td>
                                <td>@usuario.email</td>
                                <td>@usuario.login</td>
                                <td>@usuario.nivel</td>
                                <td class="text-end text-nowrap">
                                    <a asp-area="Admin" asp-controller="AdminUsuarios" asp-action="Ver" asp-route-id="@usuario.id" class="btn btn-light border btn-sm">Ver</a>
                                    <a asp-area="Admin" asp-controller="AdminUsuarios" asp-action="Editar" asp-route-id="@usuario.id" class="btn btn-light border btn-sm">Editar</a>
                                    <a asp-area="Admin" asp-controller="AdminUsuarios" asp-action="Excluir" asp-route-id="@usuario.id" class="btn btn-outline-danger btn-sm">Excluir</a>
                                </td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr><td colspan="5" class="text-center text-secondary py-4">Nenhum usuário cadastrado.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
