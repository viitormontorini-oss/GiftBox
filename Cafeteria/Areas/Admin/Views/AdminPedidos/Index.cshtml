@model List<Business.Pedido>
@using System.Globalization
@{
    ViewData["Title"] = "Pedidos";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
    var br = CultureInfo.GetCultureInfo("pt-BR");
}

<div class="container py-5">

        <h1 class="fs-2 fw-bold mb-4">Pedidos</h1>

        @* faixa verde depois de salvar (TempData, igual ao Yago) *@
        @if (TempData["Sucesso"] is string mensagem)
        {
            <div class="alert alert-success" role="status">@mensagem</div>
        }

        @* table-responsive: rola para o lado no celular. align-middle: texto no meio da linha *@
        <div class="bg-white border rounded-4 overflow-hidden">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th scope="col" class="text-secondary small text-uppercase fw-semibold">N°</th>
                            <th scope="col" class="text-secondary small text-uppercase fw-semibold">Produto</th>
                            <th scope="col" class="text-secondary small text-uppercase fw-semibold">Entrega</th>
                            <th scope="col" class="text-secondary small text-uppercase fw-semibold">Pagam.</th>
                            <th scope="col" class="text-secondary small text-uppercase fw-semibold">Total</th>
                            <th scope="col" class="text-secondary small text-uppercase fw-semibold">Status</th>
                            <th scope="col" class="text-secondary small text-uppercase fw-semibold"></th>
                        </tr>
                    </thead>

                    <tbody>

                        @* uma linha por pedido do banco (antes eram 4 linhas de exemplo) *@
                        @foreach (var pedido in Model)
                        {
                            var primeiro = pedido.produtos.FirstOrDefault()?.produto;
                            var outros = pedido.produtos.Count - 1;
                            var cor = pedido.status_pedido == "Entregue" ? "bg-success" : "bg-warning";
                            <tr>
                                <td>#@pedido.id.ToString("D6")</td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <img src="@Url.Content(primeiro?.imagem ?? "~/imgs/produtos/produto.jpg")" alt="" width="44" height="44"
                                            class="rounded-3 object-fit-cover me-3">
                                        @(primeiro?.nome ?? "—")@(outros > 0 ? $" + {outros}" : "")
                                    </div>
                                </td>
                                <td>@pedido.data_pedido.ToString("dd/MM")</td>
                                <td>@pedido.tipo_pagamento</td>
                                <td class="fw-bold">@(pedido.Total?.ToString("C2", br) ?? "—")</td>
                                <td>
                                    <span class="d-inline-flex align-items-center gap-2">
                                        <span class="rounded-circle @cor d-inline-block p-1"></span>
                                        @pedido.status_pedido
                                    </span>
                                </td>
                                <td class="text-end text-nowrap">
                                    <a asp-area="Admin" asp-controller="AdminPedidos" asp-action="Ver" asp-route-id="@pedido.id" class="btn btn-light border btn-sm">Ver</a>
                                    <a asp-area="Admin" asp-controller="AdminPedidos" asp-action="Editar" asp-route-id="@pedido.id" class="btn btn-light border btn-sm">Editar</a>
                                </td>
                            </tr>
                        }

                        @if (!Model.Any())
                        {
                            <tr><td colspan="7" class="text-center text-secondary py-4">Nenhum pedido cadastrado.</td></tr>
                        }

                    </tbody>
                </table>
            </div>
        </div>

    </div>
