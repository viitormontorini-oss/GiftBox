@model List<Business.CidadeEntrega>
@using System.Globalization
@{
    ViewData["Title"] = "Cidades de entrega";
}

@* cidades de entrega do Yago, no seu estilo (igual à lista de Produtos) *@
<div class="container py-5">

        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-2">
            <h1 class="fs-2 fw-bold mb-0">Cidades de entrega</h1>
        </div>
        <p class="text-secondary mb-4">Cidades atendidas e a taxa de cada entrega. Uma cidade inativa some das opções dos novos pedidos.</p>

        @* faixa verde depois de salvar (TempData) *@
        @if (TempData["Sucesso"] is string mensagem)
        {
            <div class="alert alert-success" role="status">@mensagem</div>
        }

        <div class="bg-white border rounded-4 overflow-hidden">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th scope="col" class="text-secondary small text-uppercase fw-semibold">Cidade</th>
                            <th scope="col" class="text-secondary small text-uppercase fw-semibold">Taxa de entrega</th>
                            <th scope="col" class="text-secondary small text-uppercase fw-semibold">Status</th>
                            <th scope="col" class="text-secondary small text-uppercase fw-semibold"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cidade in Model)
                        {
                            <tr class="@(cidade.ativa ? "" : "text-secondary")">
                                <td>@cidade.nome</td>
                                <td class="fw-bold">@cidade.taxa.ToString("C2", CultureInfo.GetCultureInfo("pt-BR"))</td>
                                <td>
                                    <span class="d-inline-flex align-items-center gap-2">
                                        <span class="rounded-circle @(cidade.ativa ? "bg-success" : "bg-secondary") d-inline-block p-1"></span>
                                        @(cidade.ativa ? "Ativa" : "Inativa")
                                    </span>
                                </td>
                                <td class="text-end text-nowrap">
                                    <a asp-area="Admin" asp-controller="AdminCidadesEntrega" asp-action="Editar" asp-route-id="@cidade.id" class="btn btn-light border btn-sm">Editar</a>
                                </td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr><td colspan="4" class="text-center text-secondary py-4">Nenhuma cidade cadastrada.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
